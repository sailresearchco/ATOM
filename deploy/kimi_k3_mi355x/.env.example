# Use the immutable digest printed by `./manage.sh build`. Tags are accepted for
# local staging, but the manifest records the resolved image ID and revision.
ATOM_IMAGE=sailresearchco/atom:k3-mi355x-REPLACE_WITH_COMMIT
ATOM_BASE_IMAGE=sailresearchco/atom@sha256:5e406e193929971848a9d49cabf95d7231f6f92b7892b9d3612ca0d01fa643cb

ATOM_CONTAINER_NAME=sail-atom-k3
ATOM_HF_CACHE_ROOT=/home/sr/.cache
ATOM_RUNTIME_CACHE_ROOT=/home/sr/.cache/atom-runtime
ATOM_SERVER_PORT=31000
ATOM_ENGINE_PORT=31100

# Validated Kimi-K3 production profile. The delayer is wired for DP1 but is
# explicit-off here to match the current MiTAC SGLang scheduling policy.
ATOM_MAX_MODEL_LEN=16384
ATOM_MAX_NUM_SEQS=32
ATOM_MAX_NUM_BATCHED_TOKENS=8192
ATOM_CONTINUOUS_DECODE_STEPS=4
ATOM_GPU_MEMORY_UTILIZATION=0.85
ATOM_DSPARK_TOKENS=4
ATOM_ENABLE_PREFILL_DELAYER=0
ATOM_PREFILL_DECODE_INTERVAL=0
