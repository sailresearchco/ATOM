# syntax=docker/dockerfile:1.7
ARG ATOM_BASE_IMAGE=rocm/atom@sha256:13d8564eeef3a267c1cc25410c78029097bd8f218b71ef37d32df971d73d25bb
FROM ${ATOM_BASE_IMAGE}

ARG ATOM_SOURCE_COMMIT=unknown
ARG ATOM_SOURCE_VERSION=0.0+unknown
LABEL org.opencontainers.image.source="https://github.com/sailresearchco/ATOM" \
      org.opencontainers.image.revision="${ATOM_SOURCE_COMMIT}" \
      ai.sail.atom.source-version="${ATOM_SOURCE_VERSION}" \
      ai.sail.atom.profile="kimi-k3-mi355x-tp8-dcp8-dspark4"

# Start from the published ROCm release underlying the historical benchmark.
# The derived benchmark was local-only and cannot be pulled by a clean builder.
# This release predates K3's fused SiTUv2 activation. Install
# the GPU artifacts qualified together on MI355X: newer AITER needs newer
# Triton, and generic PyPI Triton produces incorrect compiled-model output.
# Direct wheel URLs and hashes prevent a rebuild from selecting generic Triton
# or a different nightly. Worker/Python dependency resolution is unaffected.
ARG AITER_WHEEL=https://rocm.frameworks-nightlies.amd.com/whl-staging/gfx942-gfx950/amd_aiter-0.1.1.dev1%2Bgcdf6ee88a-cp312-cp312-linux_x86_64.whl#sha256=4f96d4463dadc87cf818002d72160b41715c516f46eab46446e999c10f38ff25
ARG TRITON_WHEEL=https://pypi.amd.com/triton/_release/rocm-7.2.0/packages/triton/triton-3.8.0%2Bamd.rocm7.2.0.git111ff227-cp312-cp312-linux_x86_64.whl#sha256=a20d7e0cd0efb8ac46dd3841d3eb337d938bb0699f0ec830d296d8ebeb92cbe0
ARG TRITON_KERNELS_WHEEL=https://pypi.amd.com/triton/_release/rocm-7.2.0/packages/triton-kernels/triton_kernels-1.0.0%2Bamd.rocm7.2.0.git111ff227-py3-none-any.whl#sha256=31b76695911f91f77736510096d7053c8db563c15f2490285a93c2ae5a487bf6
LABEL ai.sail.atom.aiter-wheel="${AITER_WHEEL}" \
      ai.sail.atom.triton-wheel="${TRITON_WHEEL}" \
      ai.sail.atom.triton-kernels-wheel="${TRITON_KERNELS_WHEEL}"
# The base also contains valid FlyDSL 0.3.2. This obsolete metadata directory
# has no RECORD and prevents pip from resolving the installed version.
RUN /opt/venv/bin/python -m pip uninstall -y amd-aiter \
 && rm -rf /app/aiter-test \
           /opt/venv/lib/python3.12/site-packages/flydsl-0.1.9.dev599.dist-info
RUN --mount=type=cache,target=/root/.cache/pip \
    /opt/venv/bin/python -m pip install --upgrade \
      "${AITER_WHEEL}" "${TRITON_WHEEL}" "${TRITON_KERNELS_WHEEL}"

# Bake the Sail fork into the runtime image so deploys never depend on a host
# bind mount or on whatever source happened to be present in the base image.
WORKDIR /opt/sail-atom
COPY pyproject.toml setup.py MANIFEST.in README.md LICENSE ./
COPY atom ./atom
COPY deploy/kimi_k3_mi355x ./deploy/kimi_k3_mi355x
ENV ATOM_MESH_BUILD=0 \
    ATOM_IMAGE_WARMUP=1 \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_ATOM=${ATOM_SOURCE_VERSION}
RUN --mount=type=cache,target=/root/.cache/pip \
    /opt/venv/bin/python -m pip install \
      --editable /opt/sail-atom
